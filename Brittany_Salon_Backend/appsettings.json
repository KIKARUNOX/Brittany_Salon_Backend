{
    "Logging": {
        "LogLevel": {
            "Default": "Information",
            "Microsoft.AspNetCore": "Warning"
        }
    },
    "AllowedHosts": "*",
  "ConnectionStrings": {
    "DefaultConnection": "Server=localhost;Database=BRITTANYSALON;Trusted_Connection=True;MultipleActiveResultSets=True;TrustServerCertificate=True;"
  },
  "JwtSettings": {
    "SecretKey": "YourSuperSecretKeyThatMustBeAtLeast32CharactersLong!@#$%",
    "Issuer": "BrittanySalonBackend",
    "Audience": "BrittanySalonClients",
    "AccessTokenExpirationMinutes": 15,
    "RefreshTokenExpirationDays": 7
  },
  "ResendSettings": {
    "SenderEmail": "onboarding@resend.dev",
    "SenderName": "Brittany Salon"
  },
  "RecoveryCode": {
    "CodeLength": 6,
    "CodeLifetimeMinutes": 15,
    "Pbkdf2Iterations": 200000,
    "SaltSizeBytes": 32,
    "MaxValidationAttempts": 5,
    "MaxRequestsPerEmailPerWindow": 3,
    "MaxRequestsPerIpPerWindow": 10,
    "RequestWindowMinutes": 15,
    "CooldownSeconds": 60
  }
}